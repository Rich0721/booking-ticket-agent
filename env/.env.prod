# PostgreSQL 生產環境配置
DB_TYPE=postgresql
DB_HOST=db
DB_PORT=5432
DB_USER=booking_user
DB_PASSWORD=${DB_PASSWORD}
DB_NAME=booking_ticket
DEBUG=False
PORT=3000
APP_VERSION=latest
NODE_ENV=production

# Frontend 生產環境配置
REACT_APP_BACKEND_URL=http://localhost:8000

# Crawler 生產環境配置
TWO_CAPTCHA_API_KEY=${TWO_CAPTCHA_API_KEY}
